{
  "name": "vite-template-redux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/axios": "^0.9.36",
    "@types/faker": "^6.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "rolldown": "1.2.8"
  }
}
